# api_id и api_hash берутся тут: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Заполняется автоматически после `npm run login`
TG_SESSION=

# Канал-источник: @username, ссылка t.me/... или числовой id.
# Можно несколько через запятую.
CHANNEL=@example_channel

# Куда пересылать совпадения. "me" = Избранное (Saved Messages).
# Либо @username / числовой id чата.
TARGET=me

# Группы ключевых слов из keywords.js, которые сейчас не нужны.
# Пусто = работают все. Несколько — через запятую. Регистр не важен.
DISABLED_GROUPS=

# --- Уведомления о проблемах (необязательно) ---
# Токен бота от @BotFather. Пусто = уведомления выключены, остаётся только журнал.
ALERT_BOT_TOKEN=
# Куда слать тревоги. Заполняется автоматически: npm run alert-setup
ALERT_CHAT_ID=

# Пороги, минуты. Значения по умолчанию можно не указывать.
# Нет сообщений из канала столько — принудительное переподключение
STALL_RECONNECT_MIN=30
# ...а столько — выход на перезапуск через systemd
STALL_GIVEUP_MIN=45
# Не повторять одну и ту же тревогу чаще
ALERT_REPEAT_MIN=60
# Час суточной сводки (время сервера)
# Час суточного отчёта «всё хорошо». Пусто — бот пишет только о проблемах.
DIGEST_HOUR=
# Столько перезапусков подряд считаем циклом
FLAPPING_RESTARTS=3
# Имя systemd-юнита для проверки
SERVICE_NAME=tg-reader

# --- Ежедневная сводка новостного канала (необязательно) ---
# Ключ Anthropic: console.anthropic.com -> API keys. Пусто = сводка выключена.
ANTHROPIC_API_KEY=
# Канал(ы)-источник новостей, через запятую. Пусто = сводка выключена.
# Это НЕ тот канал, откуда ловятся объявления по ключевым словам.
NEWS_CHANNELS=
# Кому слать сводку. Пусто = тот же получатель, что и у объявлений (TARGET).
NEWS_TARGET=
# Модель. claude-haiku-4-5 дешевле (~$1/мес), claude-opus-5 группирует точнее (~$6/мес).
NEWS_MODEL=claude-haiku-4-5
# Час сводки и зона, в которой он считается: сервер живёт по UTC, и без зоны
# сводка уехала бы на час при переходе на зимнее время.
NEWS_HOUR=7
NEWS_TZ=Europe/Belgrade
# Потолок сообщений за один прогон — защита от неожиданного счёта.
NEWS_MAX_MESSAGES=400
# Сколько пунктов оставлять в сводке. Больше — полнее, но дольше читать.
NEWS_MAX_ITEMS=35
# Прикладывать ли ссылки на оригиналы. Для приватного канала они откроются
# только у того, кто сам на него подписан, поэтому по умолчанию выключено.
NEWS_LINKS=off

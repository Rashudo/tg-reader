# api_id и api_hash берутся тут: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Заполняется автоматически после `npm run login`
TG_SESSION=

# Канал-источник: @username, ссылка t.me/... или числовой id.
# Можно несколько через запятую.
CHANNEL=@example_channel

# Куда пересылать совпадения. "me" = Избранное (Saved Messages).
# Либо @username / числовой id чата.
TARGET=me

# Группы ключевых слов из keywords.js, которые сейчас не нужны.
# Пусто = работают все. Несколько — через запятую. Регистр не важен.
DISABLED_GROUPS=

# Ограничить отдельный источник из CHANNEL только некоторыми группами.
# Источники — через точку с запятой, группы — через запятую. Пусто = каждый
# источник проверяется всеми включёнными группами.
# Пример: CHANNEL_ONLY=@novisadbaraholka=Электросамокаты;@other=Колонки,Часы
CHANNEL_ONLY=

# --- Уведомления о проблемах (необязательно) ---
# Токен бота от @BotFather. Пусто = уведомления выключены, остаётся только журнал.
ALERT_BOT_TOKEN=
# Куда слать тревоги. Заполняется автоматически: npm run alert-setup
ALERT_CHAT_ID=

# Пороги, минуты. Значения по умолчанию можно не указывать.
# Нет сообщений из канала столько — принудительное переподключение
STALL_RECONNECT_MIN=30
# ...а столько — выход на перезапуск через systemd
STALL_GIVEUP_MIN=45
# Не повторять одну и ту же тревогу чаще
ALERT_REPEAT_MIN=60
# Час суточной сводки (время сервера)
# Час суточного отчёта «всё хорошо». Пусто — бот пишет только о проблемах.
DIGEST_HOUR=
# Столько перезапусков подряд считаем циклом
FLAPPING_RESTARTS=3
# Имя systemd-юнита для проверки
SERVICE_NAME=tg-reader

# --- Модель для сводки, ответов в чате и описания картинок ---
# Чья модель: anthropic (Claude) или openai (ChatGPT). Модели в NEWS_MODEL и
# REPLY_MODEL должны быть того же поставщика.
LLM_PROVIDER=anthropic
# Ключ Anthropic: console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Ключ OpenAI: platform.openai.com -> API keys. Подписка ChatGPT Plus не подходит,
# API оплачивается отдельно.
OPENAI_API_KEY=

# --- Ежедневная сводка новостного канала (необязательно) ---
# Без ключа выбранного поставщика сводка выключена.
# Канал(ы)-источник новостей, через запятую. Пусто = сводка выключена.
# Это НЕ тот канал, откуда ловятся объявления по ключевым словам.
NEWS_CHANNELS=
# Кому слать сводку. Пусто = тот же получатель, что и у объявлений (TARGET).
NEWS_TARGET=
# Модель. claude-haiku-4-5 дешевле (~$1/мес), claude-fable-5-1 группирует точнее
# (~$12/мес). Глубина размышления: low, medium, high, xhigh, max. У Fable
# размышление всегда включено и оплачивается как выход, поэтому low — не экономия
# на качестве, а защита от счёта. Haiku параметр effort не принимает: оставьте пустым.
NEWS_MODEL=claude-fable-5-1
NEWS_EFFORT=low
# Час сводки и зона, в которой он считается: сервер живёт по UTC, и без зоны
# сводка уехала бы на час при переходе на зимнее время.
NEWS_HOUR=7
NEWS_TZ=Europe/Belgrade
# Потолок сообщений за один прогон — защита от неожиданного счёта.
NEWS_MAX_MESSAGES=400
# Сколько пунктов оставлять в сводке. Больше — полнее, но дольше читать.
NEWS_MAX_ITEMS=35
# Прикладывать ли ссылки на оригиналы. Для приватного канала они откроются
# только у того, кто сам на него подписан, поэтому по умолчанию выключено.
NEWS_LINKS=off

# --- Автоответы в чате -------------------------------------------------
# Чат, в котором сервис отвечает от вашего имени. Пусто — автоответов нет.
# Идентификатор нужен «меченый»: у обычной группы это минус и число
# (-4191861169), у супергруппы — -100 и число, у канала — @username.
# Без минуса Telegram считает число идентификатором пользователя.
REPLY_CHAT=
# Рубильник. off — сервис читает чат, но молчит. Кнопка в боте и команда
# «стоп» делают то же самое, но без перезапуска.
REPLY_ENABLED=on
# Ответы пишет Opus 4.8: $5/$25 за млн токенов против $1/$5 у Haiku.
REPLY_MODEL=claude-fable-5-1
# Глубина размышления ответчика. Реплика в чат — две строки, думать над ней
# долго незачем, а размышление оплачивается как выход.
REPLY_EFFORT=low
# Показывать ли в чате «печатает…», пока модель сочиняет ответ. Статус живёт
# ровно столько, сколько идёт запрос, и снимается отправкой или молчанием.
REPLY_TYPING=on
# Прозвища, на которые считать обращением, кроме @username. Через запятую.
REPLY_ALIASES=
# Сколько реплик по своей воле в сутки и какая пауза между ними.
REPLY_DAILY_BUDGET=4
REPLY_SPONTANEOUS_PAUSE_MIN=90
REPLY_SPONTANEOUS_PAUSE_SEC=
# То же для ответов на обращения.
REPLY_ADDRESSED_BUDGET=10
# Пауза между ответами: в минутах либо, если нужно короче, в секундах —
# секундная переменная старше минутной. 0 — отвечать без паузы.
REPLY_ADDRESSED_PAUSE_MIN=5
REPLY_ADDRESSED_PAUSE_SEC=
# Задержка перед отправкой: мгновенный ответ выдаёт бота вернее всего.
REPLY_DELAY_MIN_SEC=120
REPLY_DELAY_MAX_SEC=240
# Тихие часы, в которые оба контура молчат.
REPLY_QUIET_FROM=23
REPLY_QUIET_TO=9
# Сколько сообщений чата показывать модели и сколько новых должно накопиться,
# чтобы встревать по своей воле.
REPLY_CONTEXT=30
REPLY_MIN_FRESH=5
# Если вы сами писали в чат недавно — бот молчит.
REPLY_OWNER_SILENCE_MIN=15
# Потолок длины ответа.
REPLY_MAX_CHARS=160
# Сколько минут заготовка ждёт своей очереди, упираясь в паузу или бюджет.
# Позже этого срока отвечать поздно — вопрос уже неактуален.
REPLY_STALE_AFTER_MIN=10
# Сколько раз бот отвечает в одной ветке реплаев без оговорок. Дальше решает
# модель, получив указание молчать, если не спросили прямо; имя из
# REPLY_ALIASES считается новым обращением и оговорку снимает.
REPLY_THREAD_LIMIT=3
# Картинки: стикер или гифка вместо текста, когда так уместнее. Нужен каталог
# memes.json (npm run memes). off — только слова.
REPLY_MEMES=on
# Сколько картинок показывать модели за раз. Больше выбор — дороже каждый ответ:
# 20 позиций стоят около 1700 токенов, 40 — около 3100.
REPLY_MEME_CHOICES=20
# Сколько часов картинка отдыхает после отправки, чтобы не повторяться.
REPLY_MEME_COOLDOWN_H=72
# Когда снимать заготовленный ответ: answer — если вы ответили на сам вопрос
# (или сказали что-то в первую минуту после него), any — если вы вообще
# написали в чат хоть что-нибудь.
REPLY_OWNER_CANCEL=answer
# Реакции, которыми оценивают реплики бота: в самом чате их ставит кто угодно,
# в личке с ботом — вы, и ваша оценка перевешивает. Оценённые реплики уходят
# в промпт как образец попадания.
REPLY_GOOD_REACTIONS=💯,👍,❤️,🔥
REPLY_BAD_REACTIONS=💩,👎

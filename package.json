{
  "name": "tg-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Читает сообщения публичного Telegram-канала от имени вашего аккаунта и пересылает вам те, что совпали с массивом ключевых слов",
  "main": "src/index.js",
  "scripts": {
    "login": "node bin/login.js",
    "start": "node --disable-warning=ExperimentalWarning bin/serve.js",
    "scan": "node --disable-warning=ExperimentalWarning bin/scan.js",
    "health": "node --disable-warning=ExperimentalWarning bin/healthcheck.js",
    "digest": "node --disable-warning=ExperimentalWarning bin/digest.js",
    "alert-setup": "node bin/alert-setup.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "replies": "node --disable-warning=ExperimentalWarning bin/replies.js",
    "voice": "node --disable-warning=ExperimentalWarning bin/voice.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "dotenv": "^16.4.5",
    "input": "^1.0.1",
    "telegram": "^2.26.22"
  },
  "engines": {
    "node": ">=18"
  }
}
